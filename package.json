{
  "name": "sync-tablet",
  "version": "1.0.0",
  "description": "Sync Tablet — Phone Link para Linux",
  "main": "electron/main.js",
  "author": {
    "name": "Steven Fonseca",
    "email": "steven2021067613@gmail.com"
  },
  "homepage": "https://github.com/tuusuario/sync-tablet",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --disable-gpu --no-sandbox --disable-dev-shm-usage\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.synctablet.app",
    "productName": "Sync Tablet",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "syncthing-linux-amd64-v2.0.15",
        "to": "syncthing-linux-amd64-v2.0.15"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Steven Fonseca <steven2021067613@gmail.com>",
      "icon": "logo.png"
    },
    "icon": "logo.png",
    "appImage": {
      "executableArgs": [
        "--no-sandbox",
        "--disable-gpu",
        "--disable-dev-shm-usage"
      ]
    }
  },
  "dependencies": {
    "@cyntler/react-doc-viewer": "^1.17.1",
    "bonjour-service": "^1.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  }
}
